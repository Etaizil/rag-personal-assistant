OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-5-nano
OPENAI_EMBED_MODEL=text-embedding-3-small

EMBEDDINGS_BACKEND=local

CHROMA_DIR=.chroma
RAG_TOP_K=3
MAX_INPUT_TOKENS=1200
MAX_OUTPUT_TOKENS=500

SYSTEM_PROMPT=You are a concise, helpful AI assistant. Use the provided context only. If the context does not contain the answer, say Not found in context. Keep answers brief.

DEBUG=false
